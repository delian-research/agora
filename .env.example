# Massive.com (formerly Polygon.io) API key.
# Get yours at https://polygon.io/dashboard/api-keys
# This same key is used as the secret for the S3 flat-files endpoint.
MASSIVE_API_KEY=your_api_key_here

# S3 flat-files access key ID (per-account; visible in your Massive
# dashboard under Flat Files credentials). Required only if you use
# the bulk download pipeline (`agora.download.stocks`).
MASSIVE_S3_ACCESS_KEY_ID=your_s3_access_key_id_here

# Optional REST overrides (defaults shown):
# MASSIVE_BASE_URL=https://api.massive.com
# MASSIVE_TIMEOUT=30
# MASSIVE_MAX_RETRIES=3

# Optional S3 overrides (defaults shown):
# MASSIVE_S3_ENDPOINT=https://files.massive.com
# MASSIVE_S3_BUCKET=flatfiles
